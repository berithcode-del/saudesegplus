    "@capacitor/core": "^7.4.3",
    "@capacitor/preferences": "^7.0.2",
    "localforage": "^1.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.6.1",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "5.9.2",
    "vite": "^6.3.5"
  }
}
