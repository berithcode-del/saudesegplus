generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model UserAccount {
  id                  String          @id @default(uuid())
  email               String          @unique
  passwordHash        String
  role                Role
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  companyAdminProfile CompanyAdmin?
  doctorProfile       Doctor?
  operatorProfile     Operator?
  patientProfile      Patient?
  clinicProfile       Clinic?
  supportTickets      SupportTicket[]
}

model Clinic {
  id                    String                 @id @default(uuid())
  name                  String
  cnpj                  String                 @unique
  environment           DataEnvironment        @default(REAL)
  address               String?
  city                  String?
  state                 String?
  phone                 String?
  contactEmail          String?
  lat                   Float?
  lng                   Float?
  isActive              Boolean                @default(true)
  isFranchise           Boolean                @default(false)
  isMatriz              Boolean                @default(false)
  parentClinicId        String?
  credentialSource      String?
  userId                String?                @unique
  user                  UserAccount?           @relation(fields: [userId], references: [id])
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  calendarEvents        CalendarEvent[]
  companies             Company[]
  examRequests          ExamRequest[]
  examInvites           ExamInvite[]
  financialTransactions FinancialTransaction[]
  payments              Payment[]
  operators             Operator[]
  parentClinic          Clinic?                @relation("ClinicHierarchy", fields: [parentClinicId], references: [id])
  childClinics          Clinic[]               @relation("ClinicHierarchy")
  processosAso          ProcessoASO[]
  doctorMemberships     ClinicDoctor[]
  actorSessions         ClinicActorSession[]
  auditEvents           ClinicAuditEvent[]

  @@index([isMatriz])
  @@index([parentClinicId])
  @@index([environment, isActive])
}

model Operator {
  id                 String       @id @default(uuid())
  userId             String       @unique
  clinicId           String
  name               String
  operationalPinHash String?
  isActive           Boolean      @default(true)
  examResults        ExamResult[]
  clinic             Clinic       @relation(fields: [clinicId], references: [id])
  user               UserAccount  @relation(fields: [userId], references: [id])
}

model Doctor {
  id                    String                 @id @default(uuid())
  userId                String                 @unique
  name                  String
  environment           DataEnvironment        @default(REAL)
  gender                String?
  crmNumber             String                 @unique
  crmState              String
  phone                 String?
  contactEmail          String?
  signaturePin          String?
  signatureProvider     String?                @default("MOCK")
  city                  String?
  state                 String?
  rqeNumber             String?
  specialties           String?
  status                String                 @default("offline")
  verifiedAt            DateTime?
  credentialSource      String?
  asoDocuments          AsoDocument[]
  calendarEvents        CalendarEvent[]
  user                  UserAccount            @relation(fields: [userId], references: [id])
  financialTransactions FinancialTransaction[]
  teleconsultations     Teleconsultation[]
  processoAsos          ProcessoASO[]
  clinicMemberships     ClinicDoctor[]
  certificates          DoctorCertificate[]
  signatureAudits       SignatureAudit[]

  @@index([environment, verifiedAt])
}

model ClinicDoctor {
  id                 String    @id @default(uuid())
  clinicId           String
  doctorId           String
  active             Boolean   @default(true)
  startedAt          DateTime  @default(now())
  endedAt            DateTime?
  operationalPinHash String?
  clinic             Clinic    @relation(fields: [clinicId], references: [id])
  doctor             Doctor    @relation(fields: [doctorId], references: [id])

  @@unique([clinicId, doctorId])
  @@index([clinicId, active])
  @@index([doctorId, active])
}

model ClinicActorSession {
  id          String             @id @default(uuid())
  clinicId    String
  actorType   ClinicActorType
  actorId     String
  actorName   String
  startedAt   DateTime           @default(now())
  lastSeenAt  DateTime           @default(now())
  expiresAt   DateTime
  endedAt     DateTime?
  clinic      Clinic             @relation(fields: [clinicId], references: [id])
  auditEvents ClinicAuditEvent[]

  @@index([clinicId, endedAt])
  @@index([actorType, actorId])
}

model ClinicAuditEvent {
  id             String              @id @default(uuid())
  clinicId       String
  actorSessionId String?
  actorType      ClinicActorType
  actorId        String
  actorName      String
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  createdAt      DateTime            @default(now())
  clinic         Clinic              @relation(fields: [clinicId], references: [id])
  actorSession   ClinicActorSession? @relation(fields: [actorSessionId], references: [id])

  @@index([clinicId, createdAt])
  @@index([resourceType, resourceId])
}

/// Empresa contratante — cliente comercial da plataforma
model Company {
  id                    String                   @id @default(uuid())
  cnpj                  String                   @unique
  environment           DataEnvironment          @default(REAL)
  razaoSocial           String                   @default("")
  nomeFantasia          String?
  /// Campos legados mantidos para compatibilidade com seed existente
  name                  String?
  planType              String?
  /// Endereço e Geolocalização (para cálculo de clínica mais próxima)
  address               String?
  cep                   String?
  city                  String?
  state                 String?
  phone                 String?
  contactEmail          String?
  lat                   Float?
  lng                   Float?
  /// Status de operação da empresa na plataforma
  status                CompanyStatus            @default(CADASTRO_INCOMPLETO)
  /// Clínica atribuída automaticamente por proximidade geográfica
  clinicId              String?
  /// Documentação obrigatória vigente e datas de validade
  pcmsoDocumentUrl      String?
  ppraDocumentUrl       String?
  pcmsoValidUntil       DateTime?
  ppraValidUntil        DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  calendarEvents        CalendarEvent[]
  clinic                Clinic?                  @relation(fields: [clinicId], references: [id])
  admins                CompanyAdmin[]
  documents             CompanyDocument[]
  patients              CompanyPatientRelation[]
  examInvites           ExamInvite[]
  financialTransactions FinancialTransaction[]
  payments              Payment[]
  processosAso          ProcessoASO[]

  @@index([environment, status])
}

/// Papel "Cadastrador" — único papel por empresa nesta fase
model CompanyAdmin {
  id        String      @id @default(uuid())
  userId    String      @unique
  companyId String
  createdAt DateTime    @default(now())
  company   Company     @relation(fields: [companyId], references: [id])
  user      UserAccount @relation(fields: [userId], references: [id])
}

/// Token de convite gerado pela Empresa para um colaborador específico
model ExamInvite {
  id                  String              @id @default(uuid())
  /// Token UUID não-sequencial, transmitido no link enviado ao colaborador
  token               String              @unique @default(uuid())
  companyId           String
  /// Clínica associada ao convite (para agendamento/atendimento)
  clinicId            String?
  /// Vínculo de identidade esperado — reduz risco de uso indevido do link
  expectedCpf         String?
  expectedEmail       String?
  /// Função CBO e tipo de exame pré-definidos — não digitados livremente
  roleFunction        String
  /// Código CBO numérico (ex: "7232-10") — preenchido via autocomplete
  roleFunctionCboCode String?
  examType            String
  status              InviteStatus        @default(ENVIADO)
  expiresAt           DateTime
  sentAt              DateTime            @default(now())
  openedAt            DateTime?
  createdAt           DateTime            @default(now())
  collaboratorName    String?
  expectedBirthDate   DateTime?
  company             Company             @relation(fields: [companyId], references: [id])
  clinic              Clinic?             @relation(fields: [clinicId], references: [id])
  examRequest         ExamRequest?
  processoAso         ProcessoASO?
  processoAsoId       String?             @unique
  timelineEvents      ExamTimelineEvent[]
  payment             Payment?            @relation(fields: [paymentId], references: [id])
  paymentId           String?             @unique
}

/// Eventos append-only — apenas progresso operacional, nunca dado clínico
model ExamTimelineEvent {
  id            String            @id @default(uuid())
  inviteId      String?
  examRequestId String?
  eventType     TimelineEventType
  occurredAt    DateTime          @default(now())
  metadata      String?
  examRequest   ExamRequest?      @relation(fields: [examRequestId], references: [id])
  invite        ExamInvite?       @relation(fields: [inviteId], references: [id])
}

model Patient {
  id              String                   @id @default(uuid())
  userId          String                   @unique
  cpf             String                   @unique
  environment     DataEnvironment          @default(REAL)
  name            String
  birthDate       DateTime?
  phone           String?
  functionCboCode String?
  status          String                   @default("ACTIVE")
  createdAt       DateTime                 @default(now())
  anamneses       Anamnese[]
  companies       CompanyPatientRelation[]
  examRequests    ExamRequest[]
  user            UserAccount              @relation(fields: [userId], references: [id])
  documents       PatientDocument[]
  processoAsos    ProcessoASO[]

  @@index([name])
  @@index([environment, name])
}

/// Vínculo entre Empresa e Paciente/Colaborador (suporta múltiplos vínculos)
model CompanyPatientRelation {
  id        String    @id @default(uuid())
  companyId String
  patientId String
  startDate DateTime  @default(now())
  endDate   DateTime?
  company   Company   @relation(fields: [companyId], references: [id])
  patient   Patient   @relation(fields: [patientId], references: [id])
}

model OccupationalRisk {
  id                      String   @id @default(uuid())
  cboCode                 String   @unique
  functionName            String
  riskGrade               String
  requiresInPerson        Boolean  @default(false)
  requiredExams           String[]
  periodicFrequencyMonths Int      @default(12)
}

model ExamType {
  id                String       @id @default(uuid())
  name              String
  category          String
  requiresEquipment Boolean      @default(false)
  canBeRemoteReview Boolean      @default(true)
  validityDays      Int          @default(365)
  examResults       ExamResult[]
}

model ExamRequest {
  id                    String                 @id @default(uuid())
  patientId             String
  clinicId              String?
  environment           DataEnvironment        @default(REAL)
  /// Convite de origem (preenchido quando o paciente chegou via link da empresa)
  inviteId              String?                @unique
  /// Origem do cadastro: 'direto' | 'convite_empresa'
  source                String                 @default("direto")
  examPurpose           String
  status                String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  asoDocuments          AsoDocument[]
  clinic                Clinic?                @relation(fields: [clinicId], references: [id])
  invite                ExamInvite?            @relation(fields: [inviteId], references: [id])
  patient               Patient                @relation(fields: [patientId], references: [id])
  results               ExamResult[]
  timelineEvents        ExamTimelineEvent[]
  financialTransactions FinancialTransaction[]
  documents             PatientDocument[]
  queueEntry            QueueEntry?
  teleconsultations     Teleconsultation[]
  payment               Payment?               @relation(fields: [paymentId], references: [id])
  paymentId             String?                @unique
  /// Protocolo ASO associado (opcional para compatibilidade com dados legados)
  processoAsoId         String?                @unique @map("processo_aso_id")
  processoAso           ProcessoASO?           @relation("ProcessoASOExamRequest", fields: [processoAsoId], references: [id])

  @@index([environment, status])
}

model ExamResult {
  id              String          @id @default(uuid())
  requestId       String
  typeId          String
  valueJson       String
  attachmentUrl   String?
  collectedById   String?
  performedByType ClinicActorType @default(OPERATOR)
  performedById   String
  performedByName String
  actorSessionId  String?
  collectedAt     DateTime        @default(now())
  source          String          @default("manual")
  collectedBy     Operator?       @relation(fields: [collectedById], references: [id])
  request         ExamRequest     @relation(fields: [requestId], references: [id])
  type            ExamType        @relation(fields: [typeId], references: [id])

  @@unique([requestId, typeId])
}

model QueueEntry {
  id               String      @id @default(uuid())
  requestId        String      @unique
  enteredQueueAt   DateTime    @default(now())
  priorityScore    Int         @default(0)
  city             String?
  state            String?
  region           String?
  assignedDoctorId String?
  assignedAt       DateTime?
  status           String      @default("WAITING")
  request          ExamRequest @relation(fields: [requestId], references: [id])
}

model Teleconsultation {
  id             String      @id @default(uuid())
  requestId      String
  doctorId       String
  startedAt      DateTime    @default(now())
  endedAt        DateTime?
  videoSessionId String?
  recordingUrl   String?
  clinicalNotes  String?
  hostRoomUrl    String?
  doctor         Doctor      @relation(fields: [doctorId], references: [id])
  request        ExamRequest @relation(fields: [requestId], references: [id])
}

model Anamnese {
  id                   String   @id @default(uuid())
  patientId            String
  queixas              String?
  historicoOcupacional String?
  historicoMedico      String?
  medicamentos         String?
  habitos              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  patient              Patient  @relation(fields: [patientId], references: [id])
}

model CompanyDocument {
  id           String    @id @default(uuid())
  companyId    String
  type         String
  fileUrl      String
  originalName String
  uploadedAt   DateTime  @default(now())
  validUntil   DateTime?
  company      Company   @relation(fields: [companyId], references: [id])
}

model PatientDocument {
  id           String      @id @default(uuid())
  patientId    String
  requestId    String
  tipo         String
  fileUrl      String
  originalName String
  uploadedAt   DateTime    @default(now())
  patient      Patient     @relation(fields: [patientId], references: [id])
  request      ExamRequest @relation(fields: [requestId], references: [id])
}

model AsoDocument {
  id                    String      @id @default(uuid())
  requestId             String
  doctorId              String
  decision              String
  restrictionNotes      String?
  pdfUrl                String?
  signatureProviderId   String?
  signatureProvider     String?
  certificateThumbprint String?
  signaturePolicy       String?
  signatureTimestamp    DateTime?
  signedAt              DateTime?
  validUntil            DateTime?
  doctor                Doctor      @relation(fields: [doctorId], references: [id])
  request               ExamRequest @relation(fields: [requestId], references: [id])
}

model DoctorCertificate {
  id                    String   @id @default(uuid())
  doctorId              String
  providerName          String
  certificateThumbprint String   @unique
  certificateSubjectDN  String
  issuerDN              String
  validFrom             DateTime
  validUntil            DateTime
  status                String   @default("ACTIVE")
  createdAt             DateTime @default(now())
  doctor                Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, status])
}

model SignatureAudit {
  id           String   @id @default(uuid())
  doctorId     String
  providerName String
  action       String
  documentId   String?
  metadata     Json?
  ipAddress    String?
  occurredAt   DateTime @default(now())
  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, occurredAt])
}

model CalendarEvent {
  id        String   @id @default(uuid())
  title     String
  type      String   @default("geral")
  date      DateTime
  doctorId  String?
  companyId String?
  clinicId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  company   Company? @relation(fields: [companyId], references: [id])
  doctor    Doctor?  @relation(fields: [doctorId], references: [id])
}

/// Tabela de preços configurável por tipo de exame
model ServicePrice {
  id                 String                 @id @default(uuid())
  /// Ex: "Exame Admissional", "Exame Periódico"
  name               String
  description        String?
  /// Preço cobrado da empresa
  basePrice          Float                  @default(250.0)
  /// % de repasse para a clínica
  clinicFeePercent   Float                  @default(30.0)
  /// % de honorário para o médico
  doctorFeePercent   Float                  @default(40.0)
  /// % de margem para a plataforma
  platformFeePercent Float                  @default(30.0)
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  transactions       FinancialTransaction[]
}

/// Item de precificacao usado na composicao do pacote ocupacional.
model ExamItemPrice {
  id                 String            @id @default(uuid())
  code               String            @unique
  name               String
  category           PriceItemCategory
  amount             Float
  clinicFeePercent   Float             @default(30.0)
  doctorFeePercent   Float             @default(40.0)
  platformFeePercent Float             @default(30.0)
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([category, isActive])
}

/// Pagamento do pacote antes da criacao do convite ou atendimento presencial.
model Payment {
  id              String                 @id @default(uuid())
  flow            PaymentFlow
  status          PaymentStatus          @default(PENDENTE)
  amount          Float
  method          String?
  companyId       String?
  clinicId        String?
  quoteSnapshot   String
  checkoutPayload String?
  externalId      String?                @unique
  confirmedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  company         Company?               @relation(fields: [companyId], references: [id])
  clinic          Clinic?                @relation(fields: [clinicId], references: [id])
  invite          ExamInvite?
  examRequest     ExamRequest?
  transactions    FinancialTransaction[]

  @@index([companyId, status])
  @@index([clinicId, status])
}

/// Configuração global de repasse — valores padrão da plataforma
model FinancialConfig {
  id                        String   @id @default(uuid())
  defaultClinicFeePercent   Float    @default(30.0)
  defaultDoctorFeePercent   Float    @default(40.0)
  defaultPlatformFeePercent Float    @default(30.0)
  updatedAt                 DateTime @updatedAt
}

/// Transação financeira — gerada automaticamente ao emitir ASO ou lançada manualmente
model FinancialTransaction {
  id              String            @id @default(uuid())
  type            FinancialType
  category        FinancialCategory
  description     String
  amount          Float
  status          PaymentStatus     @default(PENDENTE)
  /// PIX | BOLETO | TRANSFERENCIA | DINHEIRO
  method          String?
  notes           String?
  examRequestId   String?
  clinicId        String?
  doctorId        String?
  companyId       String?
  servicePriceId  String?
  paymentId       String?
  transactionDate DateTime          @default(now())
  paidAt          DateTime?
  createdAt       DateTime          @default(now())
  clinic          Clinic?           @relation(fields: [clinicId], references: [id])
  company         Company?          @relation(fields: [companyId], references: [id])
  doctor          Doctor?           @relation(fields: [doctorId], references: [id])
  examRequest     ExamRequest?      @relation(fields: [examRequestId], references: [id])
  servicePrice    ServicePrice?     @relation(fields: [servicePriceId], references: [id])
  payment         Payment?          @relation(fields: [paymentId], references: [id])
}

/// Chamado de suporte aberto por Empresa/Clínica/Médico
model SupportTicket {
  id          String              @id @default(uuid())
  userId      String
  userProfile String /// "EMPRESA" | "CLINICA" | "MEDICO"
  companyId   String?
  clinicId    String?
  doctorId    String?
  subject     String
  status      SupportTicketStatus @default(ABERTO)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user     UserAccount      @relation(fields: [userId], references: [id])
  messages SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// Mensagem dentro de um chamado de suporte
model SupportMessage {
  id         String   @id @default(uuid())
  ticketId   String
  content    String
  authorId   String
  authorRole String /// "USER" | "ADMIN"
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model OperatorConversation {
  id           String                            @id @default(uuid())
  title        String?
  isGroup      Boolean                           @default(false)
  createdAt    DateTime                          @default(now())
  updatedAt    DateTime                          @updatedAt
  participants OperatorConversationParticipant[]
  messages     OperatorMessage[]

  @@index([updatedAt])
}

model OperatorConversationParticipant {
  id             String               @id @default(uuid())
  conversationId String
  userId         String
  role           Role
  displayName    String?
  lastReadAt     DateTime?
  joinedAt       DateTime             @default(now())
  conversation   OperatorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model OperatorMessage {
  id             String               @id @default(uuid())
  conversationId String
  authorId       String
  authorName     String?
  content        String               @db.Text
  attachments    String[]
  sentAt         DateTime             @default(now())
  conversation   OperatorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  targetId  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/// Protocolo único que acompanha todo o processo de ASO — da abertura à emissão
model ProcessoASO {
  id              String          @id @default(uuid())
  numeroProtocolo String          @unique @map("numero_protocolo")
  empresaId       String          @map("empresa_id")
  empresa         Company         @relation(fields: [empresaId], references: [id])
  clinicaId       String?         @map("clinica_id")
  clinica         Clinic?         @relation(fields: [clinicaId], references: [id])
  pacienteId      String?         @map("paciente_id")
  paciente        Patient?        @relation(fields: [pacienteId], references: [id])
  medicoId        String?         @map("medico_id")
  medico          Doctor?         @relation(fields: [medicoId], references: [id])
  examRequestId   String?         @unique @map("exam_request_id")
  examRequest     ExamRequest?    @relation("ProcessoASOExamRequest")
  inviteId        String?         @unique @map("invite_id")
  invite          ExamInvite?     @relation(fields: [inviteId], references: [id])
  status          StatusProtocolo @default(INICIADO)
  tipoExame       TipoExame       @map("tipo_exame")
  dataAbertura    DateTime        @default(now()) @map("data_abertura")
  dataConclusao   DateTime?       @map("data_conclusao")
  documentos      Json            @default("[]")
  historico       Json            @default("[]")
  observacoes     String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([empresaId])
  @@index([clinicaId])
  @@index([pacienteId])
  @@index([medicoId])
  @@index([status])
  @@index([numeroProtocolo])
  @@map("processos_aso")
}

enum StatusProtocolo {
  INICIADO
  EM_PROGRESSO
  FINALIZADO
}

enum TipoExame {
  ADMISSIONAL
  PERIODICO
  DEMISSIONAL
  MUDANCA_FUNCAO
  RETORNO_TRABALHO
}

/// Papel do usuário na plataforma
enum Role {
  OPERATOR
  DOCTOR
  PATIENT
  COMPANY_ADMIN
  CLINIC
  ADMIN
}

enum DataEnvironment {
  REAL
  SANDBOX
}

enum CompanyStatus {
  CADASTRO_INCOMPLETO
  EM_ANALISE
  LIBERADA
  DOCUMENTACAO_VENCIDA
}

enum ClinicActorType {
  OPERATOR
  DOCTOR
  CLINIC_ADMIN
}

enum InviteStatus {
  ENVIADO
  ABERTO
  EXPIRADO
  CONCLUIDO
}

enum TimelineEventType {
  LINK_ENVIADO
  LINK_ABERTO
  CADASTRO_CONCLUIDO
  COLABORADOR_CADASTRADO
  EXAME_INICIADO
  EM_ATENDIMENTO_MEDICO
  CONCLUIDO
  DADOS_CONFIRMADOS
  DOCUMENTOS_ENVIADOS
  QUESTIONARIO_RESPONDIDO
  TELECONSULTA_INICIADA
  TELECONSULTA_BLOQUEADA
}

enum FinancialType {
  /// Empresa pagou pelo exame → entra na plataforma
  RECEITA
  /// Custo operacional da plataforma
  DESPESA
  /// Saída para clínica ou médico
  REPASSE
}

enum FinancialCategory {
  EXAME_ASO
  HONORARIO_MEDICO
  TAXA_CLINICA
  CUSTO_OPERACIONAL
  OUTROS
}

enum PaymentStatus {
  PENDENTE
  PAGO
  CANCELADO
  ESTORNADO
}

enum PaymentFlow {
  COMPANY_INVITE
  CLINIC_WALK_IN
}

enum PriceItemCategory {
  ASO
  EXAM
  SPECIAL_CLEARANCE
}

